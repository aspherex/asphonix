---
source: crates/sonix-mcp/tests/snapshots.rs
expression: tools
---
[
  {
    "control": false,
    "description": "Full-text search of the local library mirror (title/artist/album names, prefix matching, diacritic-insensitive). Returns compact tracks, albums, artists and playlists with ids you can pass to other tools.",
    "name": "search",
    "schema": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 20,
          "description": "Rows per page (hard maximum 200).",
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "query": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "default": "all",
          "enum": [
            "all",
            "track",
            "album",
            "artist",
            "playlist"
          ]
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    }
  },
  {
    "control": false,
    "description": "Page through every track in the library with the same sort/filter as SONIX's Tracks view. `filter` is a text match on title/artist/album. For richer filtering (genre, duration, last played, rating, year) use get_smart_playlist_tracks with ad-hoc rules.",
    "name": "get_tracks",
    "schema": {
      "additionalProperties": false,
      "properties": {
        "dir": {
          "default": "asc",
          "enum": [
            "asc",
            "desc"
          ]
        },
        "filter": {
          "maxLength": 200,
          "type": "string"
        },
        "limit": {
          "default": 50,
          "description": "Rows per page (hard maximum 200).",
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "sort": {
          "default": "title",
          "enum": [
            "title",
            "artist",
            "album",
            "year",
            "dateAdded",
            "duration",
            "format"
          ]
        }
      },
      "required": [],
      "type": "object"
    }
  },
  {
    "control": false,
    "description": "One album with a page of its tracks in disc/track order.",
    "name": "get_album",
    "schema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "limit": {
          "default": 100,
          "description": "Rows per page (hard maximum 200).",
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    }
  },
  {
    "control": false,
    "description": "One artist with a page of their albums (use get_tracks/search for individual tracks).",
    "name": "get_artist",
    "schema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "limit": {
          "default": 100,
          "description": "Rows per page (hard maximum 200).",
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    }
  },
  {
    "control": false,
    "description": "The user's server playlists (id, name, track count, duration, owner).",
    "name": "list_playlists",
    "schema": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 100,
          "description": "Rows per page (hard maximum 200).",
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    }
  },
  {
    "control": false,
    "description": "One playlist with a page of its tracks in playlist order.",
    "name": "get_playlist",
    "schema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "limit": {
          "default": 100,
          "description": "Rows per page (hard maximum 200).",
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    }
  },
  {
    "control": false,
    "description": "Genres with album and track counts. There is no instrumental/vocal flag in the library: genre names are the only signal for 'no vocals'.",
    "name": "list_genres",
    "schema": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 100,
          "description": "Rows per page (hard maximum 200).",
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "sort": {
          "default": "tracks",
          "enum": [
            "tracks",
            "alphabetical"
          ]
        }
      },
      "required": [],
      "type": "object"
    }
  },
  {
    "control": false,
    "description": "The user's local smart playlists (rule definitions, not tracks).",
    "name": "list_smart_playlists",
    "schema": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 100,
          "description": "Rows per page (hard maximum 200).",
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    }
  },
  {
    "control": false,
    "description": "Evaluate a smart playlist (pass `id`) or an ad-hoc rule set (pass `rules`; nothing is saved) against the local library and return a page of matching tracks. Use this for questions like 'genre X, shorter than 6 minutes, not played in 7 days'. Rule values: duration in seconds; lastPlayed ops olderThanDays/withinDays/never.",
    "name": "get_smart_playlist_tracks",
    "schema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "A saved smart playlist id (see list_smart_playlists).",
          "type": "string"
        },
        "limit": {
          "default": 50,
          "description": "Rows per page (hard maximum 200).",
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "rules": {
          "description": "Ad-hoc smart-playlist rules (nothing is saved). Same model as SONIX smart playlists.",
          "properties": {
            "limit": {
              "description": "Cap on the evaluated list.",
              "minimum": 1,
              "type": "integer"
            },
            "matchMode": {
              "default": "all",
              "enum": [
                "all",
                "any"
              ]
            },
            "rules": {
              "items": {
                "properties": {
                  "field": {
                    "enum": [
                      "rating",
                      "starred",
                      "playCount",
                      "lastPlayed",
                      "dateAdded",
                      "genre",
                      "year",
                      "artist",
                      "duration",
                      "format",
                      "bitDepth",
                      "sampleRate"
                    ]
                  },
                  "op": {
                    "enum": [
                      "eq",
                      "gte",
                      "lte",
                      "unrated",
                      "yes",
                      "no",
                      "never",
                      "olderThanDays",
                      "withinDays",
                      "is",
                      "isNot",
                      "contains"
                    ]
                  },
                  "value": {
                    "description": "duration is in seconds; day ops take a number of days.",
                    "type": [
                      "number",
                      "string"
                    ]
                  }
                },
                "required": [
                  "field",
                  "op"
                ],
                "type": "object"
              },
              "maxItems": 20,
              "type": "array"
            },
            "sort": {
              "default": "title",
              "enum": [
                "random",
                "recentlyAdded",
                "mostPlayed",
                "recentlyPlayed",
                "title",
                "artist",
                "rating"
              ]
            }
          },
          "required": [
            "rules"
          ],
          "type": "object"
        },
        "seed": {
          "description": "Makes `random` sort stable across pages.",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    }
  },
  {
    "control": false,
    "description": "Plays recorded by SONIX (a play counts after the user's play threshold), newest first. Only plays since SONIX started recording are present; plays from other clients are not. Call library_stats first if you need the current local date/time.",
    "name": "listening_history",
    "schema": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 50,
          "description": "Rows per page (hard maximum 200).",
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "since": {
          "description": "Start (inclusive). ISO 8601 date (YYYY-MM-DD, local midnight; as `until` it includes that whole day) or date-time (with offset, or local time without one).",
          "type": "string"
        },
        "until": {
          "description": "End (exclusive). ISO 8601 date (YYYY-MM-DD, local midnight; as `until` it includes that whole day) or date-time (with offset, or local time without one).",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    }
  },
  {
    "control": false,
    "description": "Every listening session SONIX recorded, newest first: start and end time, seconds actually heard, track length, how it ended (finished, next, previous, jump, stopped, quit, error), the queue source it played from, whether the user queued it or it came from the source/autoplay, and whether it counted as a play. A skip made through a playback tool looks the same as one the user made. Only sessions since SONIX started recording them exist.",
    "name": "listen_events",
    "schema": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 50,
          "description": "Rows per page (hard maximum 200).",
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "since": {
          "description": "Start (inclusive, on startedAt). ISO 8601 date (YYYY-MM-DD, local midnight; as `until` it includes that whole day) or date-time (with offset, or local time without one).",
          "type": "string"
        },
        "until": {
          "description": "End (exclusive). ISO 8601 date (YYYY-MM-DD, local midnight; as `until` it includes that whole day) or date-time (with offset, or local time without one).",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    }
  },
  {
    "control": false,
    "description": "Per-track aggregate of listen_events over a time range, most-listened first: sessions, skips (ended by next/previous/jump with under 80% heard), plays counted, average fraction heard, last listened. Useful for 'what do I keep skipping'.",
    "name": "skip_stats",
    "schema": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 50,
          "description": "Rows per page (hard maximum 200).",
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "minSessions": {
          "default": 1,
          "description": "Only tracks with at least this many sessions.",
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "since": {
          "description": "Start (inclusive). ISO 8601 date (YYYY-MM-DD, local midnight; as `until` it includes that whole day) or date-time (with offset, or local time without one).",
          "type": "string"
        },
        "until": {
          "description": "End (exclusive). ISO 8601 date (YYYY-MM-DD, local midnight; as `until` it includes that whole day) or date-time (with offset, or local time without one).",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    }
  },
  {
    "control": false,
    "description": "Most-played tracks over a time range (from SONIX's own play history), with play counts, last-played time and whether the track is liked (`starred`). Set unlikedOnly to answer 'what did I play a lot but never liked'.",
    "name": "top_tracks",
    "schema": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 25,
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "since": {
          "description": "Start (inclusive). ISO 8601 date (YYYY-MM-DD, local midnight; as `until` it includes that whole day) or date-time (with offset, or local time without one).",
          "type": "string"
        },
        "unlikedOnly": {
          "default": false,
          "type": "boolean"
        },
        "until": {
          "description": "End (exclusive). ISO 8601 date (YYYY-MM-DD, local midnight; as `until` it includes that whole day) or date-time (with offset, or local time without one).",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    }
  },
  {
    "control": false,
    "description": "Most-played artists over a time range (from SONIX's own play history) with play counts and the number of distinct tracks played.",
    "name": "top_artists",
    "schema": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 25,
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "since": {
          "description": "Start (inclusive). ISO 8601 date (YYYY-MM-DD, local midnight; as `until` it includes that whole day) or date-time (with offset, or local time without one).",
          "type": "string"
        },
        "until": {
          "description": "End (exclusive). ISO 8601 date (YYYY-MM-DD, local midnight; as `until` it includes that whole day) or date-time (with offset, or local time without one).",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    }
  },
  {
    "control": false,
    "description": "The current track, status, position and the real output format (device mode, bit depth, sample rate, bit-perfect).",
    "name": "now_playing",
    "schema": {
      "additionalProperties": false,
      "properties": {},
      "required": [],
      "type": "object"
    }
  },
  {
    "control": false,
    "description": "A page of the play queue (history, current track, upcoming). `currentIndex` locates the current track; `source` says which playlist/artist/etc. the queue rolls from. Items with origin 'user' were queued explicitly.",
    "name": "get_queue",
    "schema": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 50,
          "description": "Rows per page (hard maximum 200).",
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    }
  },
  {
    "control": false,
    "description": "Library counts (tracks, albums, artists, playlists, liked, recorded plays), the last sync time and the current local date/time and UTC offset.",
    "name": "library_stats",
    "schema": {
      "additionalProperties": false,
      "properties": {},
      "required": [],
      "type": "object"
    }
  },
  {
    "control": true,
    "description": "Toggle, start or pause playback. Requires 'Allow playback control' in SONIX settings.",
    "name": "play_pause",
    "schema": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "default": "toggle",
          "enum": [
            "toggle",
            "play",
            "pause"
          ]
        }
      },
      "required": [],
      "type": "object"
    }
  },
  {
    "control": true,
    "description": "Skip to the next track. Requires 'Allow playback control'.",
    "name": "next",
    "schema": {
      "additionalProperties": false,
      "properties": {},
      "required": [],
      "type": "object"
    }
  },
  {
    "control": true,
    "description": "Previous track (restarts the current one after a few seconds, like the app). Requires 'Allow playback control'.",
    "name": "previous",
    "schema": {
      "additionalProperties": false,
      "properties": {},
      "required": [],
      "type": "object"
    }
  },
  {
    "control": true,
    "description": "Seek within the current track. Requires 'Allow playback control'.",
    "name": "seek",
    "schema": {
      "additionalProperties": false,
      "properties": {
        "positionSec": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "positionSec"
      ],
      "type": "object"
    }
  },
  {
    "control": true,
    "description": "Set the volume in dB: 0 is full scale (bit-perfect), -60 is the bottom of SONIX's range; anything below -60 mutes. Requires 'Allow playback control'.",
    "name": "set_volume_db",
    "schema": {
      "additionalProperties": false,
      "properties": {
        "db": {
          "maximum": 0,
          "type": "number"
        }
      },
      "required": [
        "db"
      ],
      "type": "object"
    }
  },
  {
    "control": true,
    "description": "Replace the queue with these track ids (max 500) and start playing at `startIndex`. Unknown ids are skipped and reported. If SONIX's shuffle mode is on (see now_playing.shuffle) the queue plays shuffled, start track first, not in the order given; the result reports shuffleOn. Requires 'Allow playback control'.",
    "name": "play_tracks",
    "schema": {
      "additionalProperties": false,
      "properties": {
        "startIndex": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "trackIds": {
          "items": {
            "type": "string"
          },
          "maxItems": 500,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "trackIds"
      ],
      "type": "object"
    }
  },
  {
    "control": true,
    "description": "Add track ids (max 500) to the queue, in the given order: 'next' right after the current track, 'end' after anything already queued explicitly. Unknown ids are skipped and reported. Requires 'Allow playback control'.",
    "name": "enqueue",
    "schema": {
      "additionalProperties": false,
      "properties": {
        "position": {
          "default": "end",
          "enum": [
            "next",
            "end"
          ]
        },
        "trackIds": {
          "items": {
            "type": "string"
          },
          "maxItems": 500,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "trackIds"
      ],
      "type": "object"
    }
  },
  {
    "control": true,
    "description": "Start playing a whole source: playlist, artist, album, genre (id = genre name), liked, smart (saved smart playlist id) or allTracks. For these rolling sources `shuffle` selects shuffled or in-order play (and becomes SONIX's global shuffle mode), and `flow` instead selects SONIX's DJ-style Flow sequencing with an energy arc: steady, build (rising) or peak (rise, then cool down). Pass shuffle or flow, not both. Album is a plain queue: with shuffle false it plays in album order unless SONIX's shuffle mode is already on (the result reports shuffleOn); with shuffle true the order is randomised once; flow is not available for albums. Requires 'Allow playback control'.",
    "name": "play_source",
    "schema": {
      "additionalProperties": false,
      "properties": {
        "flow": {
          "description": "Flow sequencing arc (not with shuffle, not for album).",
          "enum": [
            "steady",
            "build",
            "peak"
          ]
        },
        "id": {
          "description": "Required for everything except liked and allTracks.",
          "type": "string"
        },
        "kind": {
          "enum": [
            "playlist",
            "artist",
            "album",
            "genre",
            "liked",
            "smart",
            "allTracks"
          ]
        },
        "shuffle": {
          "default": false,
          "type": "boolean"
        },
        "startTrackId": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    }
  }
]
